{
  "$schema":  "https://raw.githubusercontent.com/jetify-com/devbox/0.12.0/.schema/devbox.schema.json",
  "packages": {
    "python": {
        "version": "3.10",
        "disable_plugin": false
      }
  },
  "env": {
    "VENV_DIR": "$PWD/venv",
    "UV_PYTHON": "$PWD/venv/bin/python"
  },
  "shell": {
      "init_hook": ". $VENV_DIR/bin/activate"
  }
}
